# .env additions for Databricks deployment
# Append these to your existing .env file
# (or export them before running databricks/ scripts)

# ── Databricks workspace ────────────────────────────────────────────
DATABRICKS_HOST=https://adb-7405606284470994.14.azuredatabricks.net
DATABRICKS_TOKEN=                        # paste your PAT here
DATABRICKS_HTTP_PATH=                    # SQL Warehouse HTTP path

# ── Azure ADLS Gen2 ──────────────────────────────────────────────
ADLS_STORAGE_ACCOUNT=nyctaxilakehouse    # change to your storage account name
LANDING_CONTAINER=landing
BRONZE_CONTAINER=bronze
SILVER_CONTAINER=silver
GOLD_CONTAINER=gold

# ── Unity Catalog ─────────────────────────────────────────────────
UC_CATALOG=nyc_taxi
UC_BRONZE_SCHEMA=bronze
UC_SILVER_SCHEMA=silver
UC_GOLD_SCHEMA=gold
